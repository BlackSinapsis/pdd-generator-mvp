# Configuración de Secrets para Streamlit Community Cloud
# 
# INSTRUCCIONES PARA DEPLOY:
# 1. Ve a tu app en share.streamlit.io
# 2. Haz clic en "⚙️ Settings" 
# 3. Pestaña "Secrets"
# 4. Copia el contenido de abajo (sin los comentarios #)
# 5. Reemplaza "tu_api_key_aqui" con tu API key real

# API Key de Google AI (REQUERIDO)
# El código soporta tanto GOOGLE_AI_API_KEY como GEMINI_API_KEY
GOOGLE_AI_API_KEY = "tu_api_key_aqui"

# Configuración del modelo (OPCIONAL)
MODEL_NAME = "gemini-2.5-pro"
LANGUAGE = "es"

# Configuración avanzada (OPCIONAL)  
RESIZE_VIDEO = true
RESIZE_TARGET_WIDTH = 1280
