# Configuración para PDD Agent 2.0
# Copia este archivo a .env y completa con tus valores reales

# API Key de Google AI (REQUERIDO)
# El código soporta tanto GOOGLE_AI_API_KEY como GEMINI_API_KEY
# Obtener en: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=tu_api_key_aqui

# Configuración del modelo (OPCIONAL)
MODEL_NAME=gemini-2.5-pro
LANGUAGE=es

# Configuración avanzada (OPCIONAL)
RESIZE_VIDEO=true
RESIZE_TARGET_WIDTH=1280
